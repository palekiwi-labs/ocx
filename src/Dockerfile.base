FROM debian:trixie-slim

# Install essential tools for development
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    fd-find \
    git \
    gnupg \
    jq \
    ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Configure Nix system-wide to enable flakes
# (Nix store will be mounted from nix-daemon volume if nix workflow is enabled)
RUN mkdir -p /etc/nix && \
    cat > /etc/nix/nix.conf <<EOF
experimental-features = nix-command flakes
sandbox = true
trusted-users =
EOF

# Add Nix to PATH (will be available if /nix is mounted)
ENV PATH="/nix/var/nix/profiles/default/bin:${PATH}"

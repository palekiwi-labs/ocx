FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    gnupg \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

ARG USERNAME=user
ARG UID=1000
ARG GID=1000

RUN groupadd -g ${GID} --non-unique ${USERNAME} 2>/dev/null || true && \
    useradd -u ${UID} -g ${GID} -m -s /bin/bash ${USERNAME}

# Pre-create /nix directory for single-user installation
RUN mkdir -m 0755 /nix && chown ${USERNAME}:${GID} /nix

# Switch to the OCX user for Nix installation
USER ${USERNAME}
WORKDIR /home/${USERNAME}

# Install Nix as the OCX user (Single-user Mode)
RUN curl -L https://nixos.org/nix/install | sh

# Set PATH to include Nix binaries
ENV PATH="/home/${USERNAME}/.nix-profile/bin:${PATH}"

# Enable Flakes and Configure
RUN mkdir -p /home/${USERNAME}/.config/nix && \
    echo "experimental-features = nix-command flakes" >> /home/${USERNAME}/.config/nix/nix.conf

RUN nix profile add \
    nixpkgs#ast-grep \
    nixpkgs#fd \
    nixpkgs#gh \
    nixpkgs#jq \
    nixpkgs#nushell \
    nixpkgs#ripgrep

# Switch back to root
USER root
WORKDIR /

# Clean up apt lists
RUN rm -rf /var/lib/apt/lists/*

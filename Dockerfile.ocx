FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    gnupg \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

ARG USERNAME=user
ARG UID=1000
ARG GID=1000

RUN groupadd -g ${GID} --non-unique ${USERNAME} 2>/dev/null || true && \
    useradd -u ${UID} -g ${GID} -m -s /bin/bash ${USERNAME}

RUN mkdir -m 0755 /nix && chown ${USERNAME}:${GID} /nix

USER ${USERNAME}
WORKDIR /home/${USERNAME}

# Install Nix as the OCX user (Single-user Mode)
RUN curl -L https://nixos.org/nix/install | sh

# Set PATH to include Nix binaries
# Single-user Nix installs to ~/.nix-profile/bin
# Note: This is set for the build process and non-interactive use
# Interactive shells will also source ~/.nix-profile/etc/profile.d/nix.sh automatically
ENV PATH="/home/${USERNAME}/.nix-profile/bin:${PATH}"

# Enable Flakes and Configure
RUN mkdir -p /home/${USERNAME}/.config/nix && \
    echo "experimental-features = nix-command flakes" >> /home/${USERNAME}/.config/nix/nix.conf

USER root
WORKDIR /

RUN cp -P /home/${USERNAME}/.nix-profile/bin/* /usr/local/bin/

# Clean up apt lists
RUN rm -rf /var/lib/apt/lists/*

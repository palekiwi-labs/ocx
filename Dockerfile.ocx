FROM rust:latest

# Build arguments for user creation (can be overridden by ocx build)
ARG USERNAME=user
ARG UID=1000
ARG GID=1000

# Install essential tools for development
# NOTE: rust:latest includes: curl, git, ca-certificates, gnupg, build-essential
RUN apt-get update && apt-get install -y --no-install-recommends \
    fd-find \
    jq \
    ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Add Nushell's official Gemfury repository and install nushell
RUN curl -fsSL https://apt.fury.io/nushell/gpg.key | gpg --dearmor -o /etc/apt/keyrings/fury-nushell.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/fury-nushell.gpg] https://apt.fury.io/nushell/ /" | tee /etc/apt/sources.list.d/fury-nushell.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends nushell && \
    rm -rf /var/lib/apt/lists/*

# Pre-create the cargo directory to ensure permissions are correct when the volume is mounted
RUN groupadd -g ${GID} ${USERNAME} || true && \
    useradd -u ${UID} -g ${GID} -m -s /bin/bash ${USERNAME} || true && \
    mkdir -p /home/${USERNAME}/.cargo && \
    chown ${UID}:${GID} /home/${USERNAME}/.cargo

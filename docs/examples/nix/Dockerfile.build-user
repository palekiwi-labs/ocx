FROM debian:trixie-slim

# Install essential tools for bootstrapping Nix and OCX requirements
# curl: Required for Nix install and OCX binary download
# xz-utils: Required for Nix install
# ca-certificates: Required for SSL
# git: Required for Nix flakes
# gnupg: Recommended for security
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    gnupg \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Create dedicated user for Nix installation (Single-user Mode)
# Use high UID (9999) to avoid conflicts with regular users in downstream Dockerfiles
# Regular users typically start at UID 1000, so this keeps them available
RUN useradd -u 9999 -m -s /bin/bash nixuser

# Pre-create /nix directory for single-user installation
# The Nix installer expects this directory to exist and be owned by the installing user
RUN mkdir -m 0755 /nix && chown nixuser /nix

# Switch to nixuser for Nix installation
USER nixuser
WORKDIR /home/nixuser

# Install Nix as nixuser (Single-user Mode)
# Single-user installation is simpler for containers and doesn't require a daemon
RUN curl -L https://nixos.org/nix/install | sh

# Set PATH to include Nix binaries for nixuser
# Single-user Nix installs to ~/.nix-profile/bin
ENV PATH="/home/nixuser/.nix-profile/bin:${PATH}"

# Enable Flakes and Configure for nixuser
RUN mkdir -p /home/nixuser/.config/nix && \
    echo "experimental-features = nix-command flakes" >> /home/nixuser/.config/nix/nix.conf

# Install tools via Nix as nixuser
# PATH now includes nix binaries, so we can call nix directly
RUN nix profile add \
    nixpkgs#fd \
    nixpkgs#jq \
    nixpkgs#ripgrep

# Switch back to root
USER root
WORKDIR /

# Expose Nix binaries to all users
# 1. Nix installs binaries to /home/nixuser/.nix-profile/bin (symlinks to /nix/store)
# 2. We copy the symlinks to /usr/local/bin, which is in PATH and accessible
# 3. The symlink targets (/nix/store/...) are world-readable
# 4. This makes the tools available to all users without needing Nix itself
RUN cp -P /home/nixuser/.nix-profile/bin/* /usr/local/bin/

# Clean up apt lists again just in case (good practice)
RUN rm -rf /var/lib/apt/lists/*
